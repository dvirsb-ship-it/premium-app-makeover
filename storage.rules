rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dvirsb@gmail.com', 'justask.adv@gmail.com'];
    }

    // מסמכי אימות עו"ד (רישיון, תעודה) — בעל החשבון מעלה; האדמין רשאי לצפות
    match /verifications/{uid}/{fileName=**} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // סרטון הסלפי לאימות — וידאו בלבד, עד 80MB (סרטון טלפון של ~20 שניות).
    // נמחק מהשרת אחרי החלטת האימות — ראו notifyVerificationFn.
    match /verifications/{uid}/{video} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && video.matches('selfieVideo\\..*')
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 80 * 1024 * 1024;
    }

    // מסמכי תיק שהלקוח מעלה — רק בעל החשבון
    match /case-files/{uid}/{fileName=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    function caseData(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
    }

    function validImage() {
      return request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // תמונות מקור של תיק — הלקוח מעלה; קריאה ללקוח, לעו"ד הנבחר ולאדמין בלבד
    match /case-uploads/{caseId}/orig/{img} {
      allow write: if request.auth != null && validImage()
        && caseData(caseId).clientId == request.auth.uid;
      allow read: if request.auth != null && (
        caseData(caseId).clientId == request.auth.uid
        || caseData(caseId).chosenLawyerId == request.auth.uid
        || isAdmin()
      );
    }

    // הגרסה המצונזרת (פרטים מזהים הושחרו) — הלקוח מעלה; כל משתמש מחובר צופה
    match /case-uploads/{caseId}/cens/{img} {
      allow write: if request.auth != null && validImage()
        && caseData(caseId).clientId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // ברירת מחדל — הכל חסום
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
