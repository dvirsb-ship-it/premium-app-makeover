rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dvirsb@gmail.com', 'justask.adv@gmail.com'];
    }

    // מסמכי אימות עו"ד (רישיון, תעודה) — בעל החשבון מעלה; האדמין רשאי לצפות
    match /verifications/{uid}/{fileName=**} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // מסמכי תיק שהלקוח מעלה — רק בעל החשבון
    match /case-files/{uid}/{fileName=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ברירת מחדל — הכל חסום
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
