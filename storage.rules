rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dvirsb@gmail.com', 'justask.adv@gmail.com'];
    }

    /*
     * מסמכי אימות עו"ד (רישיון, תעודה) — בעל החשבון מעלה; האדמין צופה.
     * סוג התוכן מוגבל בכוונה: קובץ HTML שמועלה לדלי מוגש חזרה כ-HTML
     * מדומיין ה-Storage, וזה XSS מאוחסן שמחכה למי שיפתח את הקישור.
     */
    match /verifications/{uid}/{fileName=**} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // סרטון הסלפי לאימות — וידאו בלבד, עד 80MB (סרטון טלפון של ~20 שניות).
    // נמחק מהשרת אחרי החלטת האימות — ראו notifyVerificationFn.
    match /verifications/{uid}/{video} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && video.matches('selfieVideo\\..*')
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 80 * 1024 * 1024;
    }

    /*
     * תמונת פרופיל של עו"ד — הוא מעלה, וכל משתמש מחובר רואה.
     *
     * הקריאה פתוחה בכוונה, בניגוד לכל שאר הדליים כאן: זו התמונה שהלקוח
     * רואה בהצעה כשהוא בוחר, והוא אינו קשור לעורך הדין בשלב הזה. זו גם
     * היחידה מבין התמונות שהמשתמש עצמו בחר לפרסם — כל השאר הן תיעוד של
     * אירוע שקרה לאדם.
     *
     * תמונות בלבד (בלי PDF): קובץ HTML בדלי מוגש חזרה כ-HTML מדומיין
     * ה-Storage, וזה XSS מאוחסן. 4MB מספיק לאווטאר בכל רזולוציה.
     */
    match /lawyer-photos/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }

    /*
     * ═══ case-files — נסגר 18/8/2026 ═══
     *
     * זה היה הנתיב שהלקוח העלה אליו מסמכי תיק. ההעלאות בוטלו ב-12/8
     * יחד עם `case-uploads`, אבל הנתיב הזה נשכח: **אף שורת קוד
     * באפליקציה אינה כותבת אליו יותר**, והכלל נשאר פתוח.
     *
     * מה שהוא הותיר: כל בעל חשבון גוגל יכול היה לאחסן קבצים של עד
     * 15MB, ללא הגבלת כמות, בדלי שאנחנו משלמים עליו. לא דליפה —
     * הקריאה הייתה של הבעלים בלבד — אלא אחסון חינם על חשבוננו.
     *
     * זו אותה מסקנה שכבר כתובה כאן על התמונות: הרשאה שאיש אינו צריך
     * היא משטח פתוח. אין כלל — אין משטח.
     */

    /*
     * ═══ תמונות התיק הוסרו מהמוצר (12/8/2026) ═══
     *
     * כאן ישבו שלושה כללים: `caseData()`, `isApprovedLawyer()`,
     * ו-`case-uploads/{caseId}` על שתי גרסאותיו — המקור והמצונזרת.
     *
     * הפלטפורמה אינה מקבלת עוד קבצים מהפונה. במקום זה הוא **מצהיר**
     * איזה תיעוד קיים בידיו, ועורך הדין רואה סימני וי — אותו אות, בלי
     * שאיש כאן יחזיק מסמך רפואי של אדם פגוע.
     *
     * זה גם מסיר את הפער שתיעדנו: הכלל שצמצם קריאה למי שהביע עניין
     * **לא היה מכוסה במבחנים**, כי אמולטור ה-Storage אינו קורא
     * מ-Firestore. אין כלל — אין פער.
     */


    // ברירת מחדל — הכל חסום
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
