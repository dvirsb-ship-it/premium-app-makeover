rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dvirsb@gmail.com', 'justask.adv@gmail.com'];
    }

    /*
     * מסמכי אימות עו"ד (רישיון, תעודה) — בעל החשבון מעלה; האדמין צופה.
     * סוג התוכן מוגבל בכוונה: קובץ HTML שמועלה לדלי מוגש חזרה כ-HTML
     * מדומיין ה-Storage, וזה XSS מאוחסן שמחכה למי שיפתח את הקישור.
     */
    match /verifications/{uid}/{fileName=**} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // סרטון הסלפי לאימות — וידאו בלבד, עד 80MB (סרטון טלפון של ~20 שניות).
    // נמחק מהשרת אחרי החלטת האימות — ראו notifyVerificationFn.
    match /verifications/{uid}/{video} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && video.matches('selfieVideo\\..*')
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 80 * 1024 * 1024;
    }

    // מסמכי תיק שהלקוח מעלה — רק בעל החשבון
    match /case-files/{uid}/{fileName=**} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    function caseData(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
    }

    /*
     * עו"ד שאושר בתור האימות. מקביל ל-isApprovedLawyer בחוקי Firestore:
     * "מחובר" אינו מספיק — התמונות המצונזרות הן עדיין תיעוד של אירוע
     * שקרה לאדם אמיתי.
     */
    function isApprovedLawyer() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/verifications/$(request.auth.uid)).data.status == 'approved';
    }

    function validImage() {
      return request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // תמונות מקור של תיק — הלקוח מעלה; קריאה ללקוח, לעו"ד הנבחר ולאדמין בלבד
    match /case-uploads/{caseId}/orig/{img} {
      allow write: if request.auth != null && validImage()
        && caseData(caseId).clientId == request.auth.uid;
      allow read: if request.auth != null && (
        caseData(caseId).clientId == request.auth.uid
        || caseData(caseId).chosenLawyerId == request.auth.uid
        || isAdmin()
      );
    }

    /*
     * הגרסה המצונזרת (פרטים מזהים הושחרו) — הלקוח מעלה.
     *
     * הקריאה הייתה פתוחה לכל משתמש מחובר, כלומר גם ללקוח אקראי שיודע
     * לנחש מזהה תיק. צנזור אינו אנונימיזציה: זו עדיין תמונת פציעה או
     * זירת תאונה. הקריאה מוגבלת למי שהתיק נוגע לו.
     */
    match /case-uploads/{caseId}/cens/{img} {
      allow write: if request.auth != null && validImage()
        && caseData(caseId).clientId == request.auth.uid;
      allow read: if request.auth != null && (
        caseData(caseId).clientId == request.auth.uid
        || caseData(caseId).chosenLawyerId == request.auth.uid
        || isAdmin()
        || isApprovedLawyer()
      );
    }

    // ברירת מחדל — הכל חסום
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
