rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isLawyer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lawyer';
    }

    // צפייה במשרד הטכנולוגי
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['dvirsb@gmail.com', 'justask.adv@gmail.com'];
    }

    /*
     * הרשאה לפעול — אישור עו"ד, הכרעה בערעור, סימון טיפול.
     * dvirsb הוא חשבון הבדיקות כלקוח ולכן צופה בלבד: קליק מוטעה בזמן בדיקה
     * לא אמור לאשר עורך דין אמיתי.
     */
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'justask.adv@gmail.com';
    }

    // עו"ד שאושר בתור האימות — רק הוא רשאי להביע עניין בתיקים
    function isApprovedLawyer() {
      return isLawyer()
        && get(/databases/$(database)/documents/verifications/$(request.auth.uid)).data.status == 'approved';
    }

    // פרופיל משתמש — רק בעל החשבון קורא וכותב
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // תיקים — בידוד מלא: לקוח רואה רק את שלו; עו"ד רואה רק תיקים שעברו ולידציה
    match /cases/{caseId} {
      // תיק נולד תמיד במצב בדיקה; רק השרת מעביר אותו הלאה
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'validating'
        && request.resource.data.interestedIds.size() == 0
        && !('offers' in request.resource.data);

      /*
       * הסרת תיק שנתקע בבדיקה — הבעלים בלבד, ורק כל עוד הוא בבדיקה
       * ואיש לא הביע בו עניין. ברגע שעורך דין ראה אותו הוא כבר לא
       * "לא קרה כלום", ומחיקה הייתה מוחקת גם את ההצעה שלו.
       */
      allow delete: if signedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'validating'
        && resource.data.interestedIds.size() == 0;

      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid
        || resource.data.chosenLawyerId == request.auth.uid
        // עו"ד *מאושר* בלבד. role נכתב ע"י המשתמש עצמו, ולכן isLawyer לבדו
        // איפשר לכל חשבון מחובר לקרוא את כל התיקים בפיד.
        || (isApprovedLawyer() && resource.data.status in ['matching', 'has_interest'])
        || isAdmin()
      );

      /*
       * בעל התיק: בחירת עו"ד ופרטי קשר בלבד — לא סטטוס אישור/ולידציה.
       *
       * `images` הוסר מהרשימה ב-12/8/2026 יחד עם ביטול העלאת הקבצים.
       * שום דבר באפליקציה אינו כותב אותו יותר, והרשאה שאיש אינו צריך
       * היא משטח פתוח: לקוח מוכן היה יכול לכתוב מערך נתיבים משלו.
       * תיקים ישנים שנושאים את השדה אינם מושפעים — הוא פשוט לא ייקרא.
       */
      // (תוצאת הוולידציה נכתבת מהשרת ב-Admin SDK; מחיקת חשבון מסמנת rejected)
      // עו"ד מאומת בלבד רשאי להביע עניין (שדות מוגבלים)
      allow update: if signedIn() && (
        (
          resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['clientContact', 'chosenLawyerId', 'status'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status in ['connected', 'rejected']
          )
          /*
           * פרטי הקשר של הלקוח מותרים רק על תיק מחובר.
           *
           * ההבטחה בדף הנחיתה — "הפנייה נפתחת בפניך, בלי שם ובלי פרטי
           * קשר" — נשמרה עד היום רק בסדר הפעולות של הקוד: chooseLawyerDb
           * כותב את clientContact יחד עם status:'connected'. אבל hasOnly
           * מתיר גם תת-קבוצה, כלומר כתיבת clientContact לבדה בזמן
           * שהסטטוס עדיין 'matching' — ואז כל עורך דין מאושר בפיד קורא
           * את הטלפון. Firestore אינו יודע להסתיר שדה בודד, ולכן
           * ההבטחה חייבת להיאכף כאן ולא בקוד הלקוח.
           */
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientContact'])
            || request.resource.data.status == 'connected'
          )
        )
        || (
          isApprovedLawyer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['interested', 'interestedIds', 'status', 'offers'])
          && request.resource.data.interestedIds.hasAll(resource.data.interestedIds)
          && request.resource.data.interested.size() >= resource.data.interested.size()
          /*
           * תקרת ההצעות — MAX_OFFERS_PER_CASE ב-src/lib/limits.ts (10).
           * נאכפת כאן ולא רק במסך: הבעת עניין היא כתיבה ישירה מהלקוח
           * ל-Firestore, כך שבדיקה במסך בלבד היא בקשה ולא מגבלה.
           * התנאי על *התוצאה* ולא על המצב הקודם — שתי הבעות עניין
           * במקביל אינן יכולות שתיהן לעבור את הגבול.
           */
          && request.resource.data.interestedIds.size() <= 10
          // הצעות של אחרים אינן ניתנות לעריכה או למחיקה
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['offers'])
            || request.resource.data.offers.diff(resource.data.get('offers', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && request.resource.data.status == 'has_interest'
          && resource.data.status in ['matching', 'has_interest']
        )
        /*
         * העו"ד הנבחר סוגר את התיק כשסיים — ורק זה.
         * בלי המעבר הזה תיק גמור נשאר "מחובר" לנצח: הוא ממשיך לשבת
         * ברשימת התיקים הפעילים שלו ומתערבב אצל הלקוח עם תיקים חיים.
         */
        || (
          resource.data.chosenLawyerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'connected'
          && request.resource.data.status == 'closed'
        )
        /*
         * הפונה מושך את פנייתו — משלו בלבד, ורק כל עוד היא פתוחה.
         *
         * מ-connected אי אפשר: שם כבר נכרת קשר עם עורך דין, וסיומו
         * הוא ביניהם ולא בלחיצה חד-צדדית. מ-closed/rejected אין מה
         * למשוך. הרשימה הסגורה של סטטוסי המקור היא הלב כאן.
         */
        || (
          resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'withdrawnAt'])
          && resource.data.status in ['matching', 'has_interest']
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.withdrawnAt is int
        )
        // אדמין-העל מכריע בערעורים — שינוי סטטוס בלבד
        || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if false;
      /*
       * התזכיר — הפרטים הרפואיים והנפשיים של הפונה, בשלמותם.
       *
       * עד 18/8/2026 התנאי היה `isApprovedLawyer()` בלבד, בלי שום תלות
       * בסטטוס התיק. מסמך התיק עצמו כן מוגבל ל-matching/has_interest,
       * אבל **תת-אוסף אינו יורש את חוקי האב ב-Firestore** — כל נתיב
       * נבדק לעצמו. כלומר עורך דין שראה תיק בפיד ורשם את המזהה יכול
       * היה לקרוא את התזכיר גם אחרי שהתיק חובר לעורך דין אחר, נסגר או
       * נדחה — בסתירה להתחייבות שהוא עצמו חותם עליה: "כל פנייה שאראה,
       * גם כזו שלא איבחר בה, היא מידע חסוי".
       *
       * עכשיו: בפיד, או שהוא הנבחר. הנבחר ממשיך לקרוא כי הוא עובד על
       * התיק. לשימוש דרך הממשק אין שינוי — כל תיק שהוא רשאי לפתוח
       * עומד גם בתנאי הזה.
       */
      match /memo/{docId} {
        allow read: if isAdmin() || (
          isApprovedLawyer() && (
            get(/databases/$(database)/documents/cases/$(caseId)).data.status
              in ['matching', 'has_interest']
            || get(/databases/$(database)/documents/cases/$(caseId)).data.chosenLawyerId
              == request.auth.uid
          )
        );
        allow write: if false;
      }

      /*
       * אבני דרך שאחרי החיבור — עורך הדין הנבחר מסמן, הלקוח קורא.
       * זה גם הנתון שעליו יתבסס החיוב פר-חיבור, ולכן רק העו"ד הנבחר כותב.
       */
      match /milestones/{key} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.clientId == request.auth.uid
          || get(/databases/$(database)/documents/cases/$(caseId)).data.chosenLawyerId == request.auth.uid
          || isAdmin()
        );
        /*
         * רק הוספה, ובחותמת אמת. אלו הרשומות שהחיוב פר-חיבור יתבסס עליהן,
         * ולכן עורך הדין אינו יכול למחוק אבן דרך שסימן או לתארך אותה אחורה.
         */
        allow create: if signedIn()
          && get(/databases/$(database)/documents/cases/$(caseId)).data.chosenLawyerId == request.auth.uid
          && request.resource.data.key == key
          && request.resource.data.at is int
          && request.resource.data.at > request.time.toMillis() - 120000
          && request.resource.data.at < request.time.toMillis() + 120000;
        allow update, delete: if false;
      }

      // פרטי הקשר של עו"ד על התיק — נכתבים בהבעת עניין, נחשפים ללקוח רק אחרי שבחר בו
      match /contacts/{lawyerUid} {
        allow write: if signedIn() && request.auth.uid == lawyerUid && isApprovedLawyer();
        allow read: if signedIn() && (
          request.auth.uid == lawyerUid
          || (
            get(/databases/$(database)/documents/cases/$(caseId)).data.clientId == request.auth.uid
            && get(/databases/$(database)/documents/cases/$(caseId)).data.chosenLawyerId == lawyerUid
          )
        );
      }
    }

    // מדריך עורכי דין — פרופיל מקצועי ציבורי למחוברים (ללא פרטי קשר); כותב רק בעליו
    match /lawyerProfiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // פרטי קשר של עו"ד — רק בעליהם והאדמין; נחשפים ללקוח דרך cases/{id}/contacts בלבד
    match /lawyerContacts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    /*
     * התראות — כל משתמש קורא רק את שלו.
     *
     * היצירה נשארת בידי משתמשים (עו"ד→לקוח, לקוח→עו"ד) כי זו הדרך שבה
     * הצדדים מעדכנים זה את זה, אבל בלי הגבלות היא צינור פישינג: כל
     * חשבון מחובר יכול היה לשלוח לכל משתמש אחר כותרת וגוף חופשיים
     * שנראים כמו הודעה רשמית מ-JustAsk. לכן: סוג מרשימה סגורה, אורך
     * מוגבל, וחותמת זמן אמיתית.
     */
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'type', 'title', 'body', 'read', 'createdAt'])
        && request.resource.data.read == false
        && request.resource.data.userId is string
        /*
         * הרשימה היא בדיוק הסוגים שהדפדפן שולח. הגרסה הראשונה כללה רק
         * ארבעה — ושכחה את מסך הוולידציה, הערעורים והאימות, שכולם
         * נכתבים גם הם מהדפדפן (הלקוח או האדמין המחובר). התוצאה הייתה
         * התראות שנדחות בשקט. הרשימה המלאה, לפי חיפוש בכל נקודות
         * השליחה: db.ts, validating.tsx, verification-queue.ts.
         */
        && request.resource.data.type in [
             'lawyer_interest', 'chosen', 'not_chosen', 'case_reverted', 'case_milestone',
             'case_withdrawn',
             'case_validated', 'case_rejected',
             'appeal_accepted', 'appeal_dismissed',
             'verification_approved', 'verification_rejected'
           ]
        /*
         * מפתח תרגום אופציונלי — הפעמון מתורגם בזמן קריאה לשפת הקורא.
         * הכותרת והגוף בעברית ממשיכים להיכתב לצידו (תאימות אחורה).
         */
        && (
          !('messageKey' in request.resource.data)
          || (request.resource.data.messageKey is string
              && request.resource.data.messageKey.size() <= 60)
        )
        && (
          !('params' in request.resource.data)
          || request.resource.data.params is map
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 400
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 120000
        && request.resource.data.createdAt < request.time.toMillis() + 120000;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    /*
     * רשימת ההמתנה של עורכי הדין מדף הנחיתה.
     *
     * הכתיבה היא **בשרת בלבד** — /api/lawyer-lead רץ עם חשבון השירות
     * ועוקף את החוקים. לכן אין כאן allow create: טופס ציבורי שכותב ישר
     * ל-Firestore הוא דלת פתוחה לזבל, וההגנות (honeypot, מגבלת גודל,
     * ולידציה) יושבות בשרת.
     *
     * הקריאה נפתחת לאדמין בלבד, כי עד עכשיו לא הייתה כלל — והראייה
     * היחידה לליד שנכנס הייתה מייל שיכול ליפול בשקט.
     */
    match /lawyerLeads/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // בקשות אימות עו"ד — העו"ד מגיש וקורא את שלו; האדמין קורא הכל ומחליט (סטטוס בלבד)
    match /verifications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      /*
       * בעל הבקשה רשאי לתקן את פרטיו ולהגיש מחדש — אך לעולם לא לאשר את עצמו.
       * ללא ההגבלה הזו כל משתמש מחובר יכול היה לכתוב status:'approved' על
       * המסמך שלו ולהפוך לעורך דין מאומת.
       */
      allow update: if (
          signedIn() && request.auth.uid == uid
          /*
           * registryChecked* הוא התיעוד של הבדיקה הידנית מול פנקס הלשכה.
           * הוא חייב להיות חסום לעורך הדין עצמו בדיוק כמו reviewedAt —
           * אחרת הראיה שהאישור נבדק נכתבת בידי מי שהיא אמורה לבדוק.
           */
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['reviewedAt', 'registryCheckedAt', 'registryCheckedBy'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'pending'
          )
        )
        || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedAt', 'registryCheckedAt', 'registryCheckedBy'])
        );
      allow delete: if false;
    }

    // ערעורי ולידציה — עו"ד פותח וקורא את שלו; האדמין קורא הכל ומכריע
    match /appeals/{id} {
      allow create: if isLawyer()
        && request.resource.data.lawyerId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if signedIn()
        && (resource.data.lawyerId == request.auth.uid || isAdmin());
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt']);
      allow delete: if false;
    }

    // פניות תמיכה — כל מחובר פותח *בשמו*; רק האדמין קורא ומטפל
    match /supportTickets/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'open'
        // בלי זה אפשר לפתוח פנייה בשם משתמש אחר ולזהם את תור התמיכה
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // בקשות מחיקת חשבון — המשתמש פותח לעצמו; האדמין קורא ומסמן ביצוע
    /*
     * מחיקה מתוזמנת. מזהה המסמך הוא ה-uid, ולכן הבעלות נאכפת במסלול
     * עצמו ולא רק בשדה — אי אפשר לתזמן מחיקה של מישהו אחר.
     *
     * המשתמש רשאי לתזמן ולבטל את שלו, ולקרוא אותו (כדי שהמסך יידע
     * להציג "המחיקה נקבעה"). הביצוע עצמו הוא Admin SDK בלבד: סימון
     * done מהדפדפן היה מבטל מחיקה בלי שהיא קרתה.
     */
    /*
     * מצב תחזוקה פנימי (חותמת הסריקה האחרונה). Admin SDK בלבד —
     * דחיפת החותמת קדימה מהדפדפן הייתה מקפיאה את המחיקות לנצח.
     */
    match /system/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deletionRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.scheduledFor is int;
      // ביטול בלבד — לא דחיית המועד ולא סימון שהמחיקה בוצעה
      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt'])
        );
      allow delete: if false;
    }

    // מדד תגובתיות של עו"ד — נכתב בשרת בלבד, גלוי לכל מחובר כדי שלקוח
    // יוכל לראות אותו על ההצעה. אין לאף אחד הרשאת כתיבה מהדפדפן.
    /*
     * כולל את מונה החיבורים שקובע מתי מסתיים הניסיון. write:false אינו
     * "עוד הגבלה" — הוא התנאי לכך שהמודל העסקי לא ניתן לאיפוס בקליק
     * מהדפדפן. הכתיבה עוברת אך ורק דרך recordConnection ב-Admin SDK.
     */
    match /lawyerStats/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    /*
     * דירוגי לקוחות על עורכי דין — נכתבים בשרת בלבד (rateLawyerFn).
     * מזהה המסמך הוא מזהה התיק, כך שדירוג אחד לכל חיבור.
     * הלקוח קורא את שלו כדי שהמסך ידע להציג "כבר דירגת"; העו"ד קורא את
     * מה שנכתב עליו. הממוצע הציבורי נחשף דרך lawyerStats בלבד.
     */
    match /ratings/{caseId} {
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid
        || resource.data.lawyerId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    /*
     * מדידת המשפך שלפני התיק — שמות אירועים בלבד, בלי תוכן שיחה.
     * המשתמש כותב רק על עצמו ורק את השדות האלה, כדי שהאוסף לא יהפוך
     * לצינור כתיבה חופשי. קריאה לאדמין בלבד; אין עדכון ואין מחיקה
     * מהדפדפן (המחיקה נעשית בשרת עם מחיקת החשבון).
     */
    match /funnelEvents/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'event', 'at'])
        && request.resource.data.event is string
        && request.resource.data.event.size() < 40
        && request.resource.data.at is int;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // מונה שימוש יומי — נכתב בשרת בלבד; המשתמש רשאי לראות את שלו
    match /usage/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // יומן שגיאות שרת — נכתב מהשרת (עוקף חוקים); האדמין קורא ומסמן טופל
    match /serverErrors/{id} {
      allow read: if isAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
      allow create, delete: if false;
    }

    // ברירת מחדל — הכל חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
